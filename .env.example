# Copy to .env before `docker compose up`. Compose reads this file for the
# Postgres container's credentials; the API reads the same variables at boot.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ara
DATABASE_USER=ara
DATABASE_PASSWORD=ara-local-dev

# The GitHub App Ara authorizes as (docs/adr/0005-github-app-not-oauth-app.md).
# Create one at https://github.com/settings/apps with:
#   Callback URL  http://localhost:3000/v1/auth/github/callback
#   Setup URL     http://localhost:3000/v1/auth/github/installation
# The private key is the PEM GitHub hands you once, either base64-encoded whole
# or on one line with the newlines written as \n.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Encrypts Forge credentials at rest. 32 bytes, base64: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Local development is plain HTTP, where a Secure cookie would never be sent.
# Leave this out everywhere else.
SESSION_SECURE_COOKIES=false

# When a Day Window counts as a Quiet Day: under this many commits *and* under
# this many changed lines. Both are a starting guess, meant to be corrected once
# they have been seen to fire.
DIGEST_QUIET_BELOW_COMMITS=3
DIGEST_QUIET_BELOW_CHANGED_LINES=50

# Which model writes a Draft, and where it is reached. OpenRouter rather than
# Moonshot directly: `@effect/ai-openai` speaks only the Responses API and
# Moonshot implements only Chat Completions. Get a key at
# https://openrouter.ai/keys — a Draft costs roughly two to five cents, because
# Kimi K3 is a reasoning model and most of the tokens billed are thinking.
OPENROUTER_API_KEY=
DRAFT_MODEL=moonshotai/kimi-k3

# How hard to try when the model rate-limits, times out, or answers with
# reasoning and no content at all. Attempts, not retries.
DRAFT_MAX_ATTEMPTS=5
DRAFT_RETRY_BASE_DELAY=2 seconds

# What the configured model charges, in US dollars per million tokens. These
# belong beside DRAFT_MODEL: pointing that at something else without moving
# these keeps reporting the old model's cost, confidently and wrongly.
MODEL_INPUT_USD_PER_MILLION_TOKENS=0.6
MODEL_OUTPUT_USD_PER_MILLION_TOKENS=2.5

# How hard Ara leans on the model provider, and how long it waits. The timeout
# covers waiting for a turn as well as the call, so a spent budget degrades into
# a Run worth trying again rather than a worker held indefinitely.
MODEL_RATE_LIMIT=20
MODEL_RATE_LIMIT_INTERVAL=1 minutes
MODEL_REQUEST_TIMEOUT=2 minutes

# The same, for GitHub — but per App installation, which is the unit GitHub
# meters (docs/adr/0005-github-app-not-oauth-app.md). The default is the quota
# GitHub grants an installation, so Ara queues behind its own limiter rather
# than being told off by GitHub's.
GITHUB_RATE_LIMIT=5000
GITHUB_RATE_LIMIT_INTERVAL=1 hours
GITHUB_REQUEST_TIMEOUT=30 seconds

# Only for `pnpm --filter @ara/api test:contract`, the one test that reads a
# real repository from GitHub. A scratch repository the App is installed on, and
# a day it actually had commits on.
CONTRACT_GITHUB_INSTALLATION_ID=
CONTRACT_GITHUB_OWNER=
CONTRACT_GITHUB_NAME=
CONTRACT_GITHUB_DAY=

# The worker runs in the same process as the API for the MVP. Turn it off to
# run the two as separate processes.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=1 seconds
